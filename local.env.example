# Copy this file to .env.local. The copy is private and ignored by Git.
# Choose a unique password with at least 16 characters; keep the quotes.
LOCAL_PASSWORD="REPLACE_WITH_YOUR_OWN_PRIVATE_PASSWORD"

# Your own server-side API keys. Do not use anyone else's credentials.
# OpenRouter is needed for AI extraction/quizzes/grading.
OPENROUTER_API_KEY=""
# Firecrawl Browser Sandbox is additionally needed for website extraction/capture.
FIRECRAWL_API_KEY=""

# Optional source discovery. Taddy needs BOTH values.
BRAVE_SEARCH_API_KEY=""
YOUTUBE_API_KEY=""
TADDY_USER_ID=""
TADDY_API_KEY=""

# Computer-only default; leave this line commented initially.
# For phone access, replace with the exact HTTPS URL from your private Tailscale Serve.
# LOCAL_ORIGIN="https://YOUR_COMPUTER.YOUR_TAILNET.ts.net"

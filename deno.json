{
  "nodeModulesDir": "manual",
  "compilerOptions": {
    "checkJs": true,
    "lib": ["dom", "dom.iterable", "es2022", "deno.ns"],
    "strict": true
  },
  "tasks": {
    "validation:snapshot": "deno run --allow-read --allow-write scripts/validation-evidence.ts snapshot",
    "validation:artifact": "deno run --allow-read --allow-write scripts/validation-evidence.ts build",
    "validation:retention": "deno run --allow-read scripts/validation-evidence.ts retention",
    "build": "deno run --allow-read --allow-write --allow-run=npx scripts/build.mjs",
    "check:migrations": "node --permission --allow-fs-read=worker/migrations ./scripts/validate-migration-chain.mjs",
    "test:acquisition": "node --test --test-timeout=30000 tests-node/acquisition-*.test.mjs",
    "test:migrations": "node --test tests-node/migration-chain.test.mjs",
    "test:material-batch": "node --test tests-node/knowledge-material-batch.test.mjs",
    "test:semantic-consent": "node --test tests-node/semantic-consent.test.mjs",
    "browser:acceptance": "node scripts/browser-acceptance.mjs",
    "browser:acceptance:login": "node scripts/browser-acceptance-login.mjs",
    "check": "deno check scripts/webpage-image-evaluation.mjs && deno check acquisition/*.ts scripts/acquisition-local.mjs && deno check src/app.js scripts/build.mjs src/features/discovery/*.js src/routes/*.js src/startup/*.js worker/*.js companion/*.js tests/*.test.js && deno check scripts/browser-acceptance-composition.mjs scripts/browser-acceptance-core.mjs scripts/browser-acceptance-login-core.mjs scripts/browser-acceptance-login.mjs scripts/browser-acceptance.mjs scripts/browser-session-state.mjs",
    "serve": "python3 -m http.server 4173 --directory dist",
    "walkthrough": "deno task build && node local/walkthrough.mjs",
    "test": "deno test --allow-read --allow-write --allow-run=git tests/",
    "start:local": "node --env-file=.env.local local/server.mjs",
    "acquisition:serve": "node --env-file=.env.acquisition scripts/acquisition-server.mjs"
  }
}

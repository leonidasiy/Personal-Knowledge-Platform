# Copy this file to .env.acquisition. Never commit the filled-in copy.
# Generate your own token: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Paste that output below and use the same token for PUBLIC_ACQUISITION_TOKEN.
ACQUISITION_TOKEN=
ACQUISITION_PORT=8788

# Keep the default when an HTTPS reverse proxy/tunnel runs on this computer.
# The HTTP listener accepts connections only from this computer.
ACQUISITION_TRANSPORT=loopback

# Alternative: direct HTTPS with a publicly trusted certificate for your hostname.
# Replace the transport above with tls and uncomment these paths.
# ACQUISITION_TLS_KEY_FILE=/absolute/path/to/privkey.pem
# ACQUISITION_TLS_CERT_FILE=/absolute/path/to/fullchain.pem
# ACQUISITION_HOST=0.0.0.0

# Alternative to putting the token in this file: remove ACQUISITION_TOKEN above
# and point to a private text file containing only the token.
# ACQUISITION_TOKEN_FILE=/absolute/path/to/acquisition-token.txt
